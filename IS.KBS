THEN     RECO = ORVI;

RULE 2-7
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = YES
         AND T8 = YES
         AND T9 = NO
THEN     RECO = ORVI;

RULE 2-8
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = YES
         AND T8 = YES
         AND T9 = YES
         AND T11 = NO
THEN     RECO = ORVI;

RULE 2-9
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = YES
         AND T8 = YES
         AND T9 = YES
         AND T11 = YES
THEN     RECO = FARINGIT;

RULE 2-10
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = NO
         AND T5 = NO
THEN     RECO = ALLERGICHESKAYA_REAKTSIYA;

RULE 2-11
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = NO
         AND T5 = YES
         AND T6 = NO
THEN     RECO = ORVI;

RULE 2-12
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = NO
         AND T5 = YES
         AND T6 = YES
         AND T7 = YES
THEN     RECO = LARINGIT;

RULE 2-13
IF       MAIN = THROAT
         AND T1 = NO
         AND T4 = NO
         AND T5 = YES
         AND T6 = YES
         AND T7 = NO
THEN     RECO = ORVI;


! --------- Branch NOSE: discharge / pain cheeks-forehead / headache patterns ---------
RULE 3-1
IF       MAIN = NOSE
         AND N1 = YES
         AND N2 = YES
THEN     RECO = GRIPP;

RULE 3-2
IF       MAIN = NOSE
         AND N1 = YES
         AND N2 = NO
         AND N3 = YES
         AND N4 = YES
         AND N5 = NO
THEN     RECO = MIGREN;

