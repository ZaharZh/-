! Name of the expert system: LOR (ENT Troubleshooter)
! Description: Preliminary ENT symptom advisor (YES/NO).
!              Text is ASCII translit for compatibility with Bab.KBS style.
! Saved file name: IS.KBS

ENDOFF;
RUNTIME;

! ACTIONS BLOCK
ACTIONS
WOPEN 1,0,0,23,79,2
ACTIVE 1
DISPLAY "



            LOR (ENT Troubleshooter) - Diagnostirovanie LOR zabolevanii

     Otvette na voprosy YES/NO dlya polucheniya predvaritelnogo vyvoda.

                 Press any key to continue~"

WCLOSE 1

   DISPLAY " Welcome to the ENT symptom advisor (ASCII translit)."
   FIND RECO
   DISPLAY " Based on the answers you have given,
   I recommend: {RECO}";


! --------- Level 1 (what bothers) -> define MAIN in strict order ---------
RULE 0-1
IF       Q1 = YES
THEN     MAIN = EAR;

RULE 0-2
IF       Q1 = NO
         AND Q2 = YES
THEN     MAIN = THROAT;

RULE 0-3
IF       Q1 = NO
         AND Q2 = NO
         AND Q3 = YES
THEN     MAIN = NOSE;

RULE 0-4
IF       Q1 = NO
         AND Q2 = NO
         AND Q3 = NO
THEN     MAIN = NONE;


! --------- Branch EAR: skin / discharge / pain / dizziness ---------
RULE 1-1
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = YES
THEN     RECO = SINUSIT;

RULE 1-2
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = NO
         AND E2 = NO
THEN     RECO = PSORIAZ_EKZEMA;

RULE 1-3
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = NO
         AND E2 = YES
         AND E9 = NO
THEN     RECO = DERMATIT;

RULE 1-4
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = NO
         AND E2 = YES
         AND E9 = YES
         AND E4 = YES
THEN     RECO = FURUNKUL;

RULE 1-5
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = NO
         AND E2 = YES
         AND E9 = YES
         AND E4 = NO
         AND E3 = YES
THEN     RECO = OTOMIKOZ;

RULE 1-6
IF       MAIN = EAR
         AND E1 = YES
         AND E12 = NO
         AND E2 = YES
         AND E9 = YES
         AND E4 = NO
         AND E3 = NO
THEN     RECO = NARUZHNYI_OTIT;

RULE 1-7
IF       MAIN = EAR
         AND E1 = NO
         AND E11 = YES
THEN     RECO = PULPIT;

RULE 1-8
IF       MAIN = EAR
         AND E1 = NO
         AND E11 = NO
         AND E5 = YES
         AND E6 = YES
THEN     RECO = VNUTRENNII_OTIT;

RULE 1-9
IF       MAIN = EAR
         AND E1 = NO
         AND E11 = NO
         AND E5 = YES
         AND E6 = NO
THEN     RECO = VESTIBULYARNYI_NEIRONIT;

RULE 1-10
IF       MAIN = EAR
         AND E1 = NO
         AND E11 = NO
         AND E5 = NO
         AND E7 = YES
THEN     RECO = NEVROLOGIYA_TROINICHNOGO_NERVA;

RULE 1-11
IF       MAIN = EAR
         AND E1 = NO
         AND E11 = NO
         AND E5 = NO
         AND E7 = NO
THEN     RECO = SREDNII_OTIT;


! --------- Branch THROAT: fever / swallowing pain / nodes / tonsil pus ---------
RULE 2-1
IF       MAIN = THROAT
         AND T1 = YES
         AND T3 = YES
THEN     RECO = ORVI_GRIPP;

RULE 2-2
IF       MAIN = THROAT
         AND T1 = YES
         AND T3 = NO
         AND T10 = NO
THEN     RECO = GRIPP;

RULE 2-3
IF       MAIN = THROAT
         AND T1 = YES
         AND T3 = NO
         AND T10 = YES
         AND T11 = NO
THEN     RECO = GRIPP;

RULE 2-4
IF       MAIN = THROAT
         AND T1 = YES
         AND T3 = NO
         AND T10 = YES
         AND T11 = YES
