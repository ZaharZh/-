THEN     RECO = SINUSIT;

RULE 3-14
IF       MAIN = NOSE
         AND N1 = NO
         AND N2 = NO
         AND N11 = YES
         AND N12 = NO
         AND N13 = NO
THEN     RECO = RINIT;



! --------- General rule ---------
RULE 9-1
IF       MAIN = NONE
THEN     RECO = K_VRACHU_DLYA_OSMOTRA;


! STATEMENTS BLOCK (questions)
ASK Q1: " Bespokoit ukho/ushi?";
CHOICES Q1: YES, NO;

ASK Q2: " Bespokoit gorlo?";
CHOICES Q2: YES, NO;

ASK Q3: " Bespokoit nos?";
CHOICES Q3: YES, NO;

! EAR: skin/discharge + dizziness/pain
ASK E1: " Est pokrasnenie i/ili shelushenie kozhi (v oblasti ukha)?";
CHOICES E1: YES, NO;

ASK E2: " Est ottek?";
CHOICES E2: YES, NO;

ASK E3: " Vydeleniya spetsificheskogo tsveta (serye, chernye, zheltye)?";
CHOICES E3: YES, NO;

ASK E4: " Est li gnoynik?";
CHOICES E4: YES, NO;

ASK E9: " Prisutstvuyut vydeleniya?";
CHOICES E9: YES, NO;

ASK E12: " Est problemy s nosoglotkoy i/ili vydeleniya?";
CHOICES E12: YES, NO;

ASK E11: " Prisutstvuet bol v zubah?";
CHOICES E11: YES, NO;

ASK E5: " Prisutstvuet golovokruzhenie?";
CHOICES E5: YES, NO;

ASK E6: " Est poterya slukha ili shum v ushakh?";
CHOICES E6: YES, NO;

ASK E7: " Bol rezkaya (YES) ili postoyannaya (NO)?";
CHOICES E7: YES, NO;


! THROAT: branch exactly as in scheme
ASK T1: " Ochen vysokaya temperatura?";
